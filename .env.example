# =============================================================================
# Middleware (Spring Boot) configuration.
#
#   cp middleware/.env.example middleware/.env
#
# Nothing here is used in production: on EKS every value comes from a ConfigMap
# or from AWS Secrets Manager via IRSA. The application reads the same variable
# names in both places, which is what lets one image run everywhere.
# =============================================================================

# ----------------------------------------------------------------- runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# JVM heap is a percentage of the container limit, so raising the container's
# memory raises the heap without editing this.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0

# ----------------------------------------------------------------- secrets provider
# `env` reads the values below. `aws` reads Secrets Manager through the default
# credential provider chain (IRSA in-cluster). Switching needs no code change.
APP_SECRETS_PROVIDER=env

# ----------------------------------------------------------------- database
# MUST MATCH database/.env  (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD).
# `./scripts/check-env.sh` verifies this.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_interview
DB_USERNAME=ai_interview_app
DB_PASSWORD=change-me-locally
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_SSL_MODE=prefer

# ----------------------------------------------------------------- auth
# HS256 requires at least 32 bytes. Startup FAILS if this is shorter — that is
# deliberate, not a bug. Generate one: ./scripts/generate-secrets.sh
JWT_SIGNING_KEY=local-dev-only-signing-key-please-replace-with-48-random-bytes
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_REFRESH_TOKEN_TTL=PT8H

# ----------------------------------------------------------------- ai service
AI_SERVICE_BASE_URL=http://ai-service:8000
# MUST MATCH backend/.env INTERNAL_API_KEY.
AI_SERVICE_API_KEY=local-dev-internal-api-key
AI_SERVICE_MAX_ATTEMPTS=2

# ----------------------------------------------------------------- storage
# `local` writes to the container volume; `s3` needs IRSA and a bucket.
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_ROOT=/var/lib/ai-interview/resumes

# ----------------------------------------------------------------- web
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_UI_ENABLED=true

# ----------------------------------------------------------------- flyway
# Owns the schema for the WHOLE database, including the ai_* tables the Python
# service maps to. Leave enabled unless you are running migrations separately.
FLYWAY_ENABLED=true

# ----------------------------------------------------------------- aws
# Never set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. The default credential
# provider chain resolves IRSA in-cluster and your SSO profile locally.
AWS_REGION=ap-south-1
# Only read when APP_SECRETS_PROVIDER=aws. These are the names the deployed
# service uses - see helm/middleware/values.yaml. In the cluster the pod reads
# them over IRSA, so no key is needed here either.
#
# In-cluster this also needs the AWS sts module on the classpath; the default
# credential chain cannot exchange the projected token without it. See the
# comment beside that dependency in pom.xml.
# APP_SECRETS_AWS_DATABASE_SECRET_ID=ai-interview/prod/database
# APP_SECRETS_AWS_APPLICATION_SECRET_ID=ai-interview/prod/application
# Only read when APP_STORAGE_TYPE=s3:
# APP_STORAGE_S3_BUCKET=
# APP_STORAGE_S3_PREFIX=resumes
